# Front-end Environment Configuration Template
# Copy this file to .env.local and customize for your environment
# DO NOT commit .env.local to git (it's already in .gitignore)

# === Required Configuration ===
# API Backend URL
REACT_APP_API_URL=http://localhost:8080/api

# === Optional Configuration ===
# AWS DSQL (for production deployment)
# REACT_APP_DSQL_CLUSTER_ENDPOINT=your-endpoint.dsql.region.on.aws
# REACT_APP_AWS_REGION=sa-east-1
# REACT_APP_DSQL_DATABASE=postgres

# Demo mode (read-only UI for presentations)
REACT_APP_READ_ONLY=false
