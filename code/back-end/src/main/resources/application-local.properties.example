# Back-end Local Development Configuration Template
# Copy this file to application-local.properties and customize for your environment
# DO NOT commit application-local.properties to git (it's already in .gitignore)

# === Database Configuration ===
# If using set-dsql-env.sh, SPRING_DATASOURCE_* variables are set automatically
# Otherwise, configure them here:
# spring.datasource.url=jdbc:postgresql://localhost:5432/todolist?sslmode=require
# spring.datasource.username=admin
# spring.datasource.password=your-password-here
spring.datasource.driver-class-name=org.postgresql.Driver

# === JPA/Hibernate Configuration ===
spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.show-sql=true

# === Schema and Initialization ===
spring.sql.init.mode=always
spring.sql.init.continue-on-error=false
spring.sql.init.schema-locations=classpath:schema.sql

# === Server Configuration ===
server.error.include-message=always

# === Demo Mode ===
# Set to true for read-only mode in presentations
demo.read-only=false
